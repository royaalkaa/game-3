# Ключ OpenAI. Реальное значение только в .env, в репозиторий не попадает.
OPENAI_API_KEY=

# Модель с распознаванием изображений и structured outputs.
PH_OPENAI_MODEL=gpt-5.4-mini

# openai или fake (fake засчитывает всё, для репетиций и нагрузочного теста).
PH_VISION_MODE=openai

# Пароль ведущего для страницы /host. Придумай длинный.
PH_HOST_TOKEN=

# Адрес, который зашит в QR-код для игроков. При запуске в Docker не нужен:
# compose собирает его из PH_DOMAIN.
PH_PUBLIC_URL=https://example.org

# Только для Docker: домен сервера, на него Caddy сам выпустит сертификат.
# Без своего домена подходит <ip-сервера-через-дефисы>.sslip.io, например 203-0-113-7.sslip.io
PH_DOMAIN=localhost
